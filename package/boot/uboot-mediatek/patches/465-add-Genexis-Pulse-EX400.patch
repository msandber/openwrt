From 53c75133ea7b5a8d712798b840ca1ca64f0f8d83 Mon Sep 17 00:00:00 2001
From: Mauri Sandberg <maukka@ext.kapsi.fi>
Date: Thu, 28 Mar 2024 20:56:27 +0200
Subject: [PATCH 465/466] add Genexis Pulse EX400

Genexis Pulse EX400 is a MT7621 board with 256MB NAND.

Signed-off-by: Mauri Sandberg <maukka@ext.kapsi.fi>

diff --git a/arch/mips/dts/Makefile b/arch/mips/dts/Makefile
index 7c4ee8b668b..67c87e0b622 100644
--- a/arch/mips/dts/Makefile
+++ b/arch/mips/dts/Makefile
@@ -16,6 +16,7 @@ dtb-$(CONFIG_BOARD_HUAWEI_HG556A) += huawei,hg556a.dtb
 dtb-$(CONFIG_BOARD_INTENO_XG6846) += inteno,xg6846.dtb
 dtb-$(CONFIG_BOARD_MT7620_RFB) += mediatek,mt7620-rfb.dtb
 dtb-$(CONFIG_BOARD_MT7620_MT7530_RFB) += mediatek,mt7620-mt7530-rfb.dtb
+dtb-$(CONFIG_BOARD_MT7621_GENEXIS_EX400) += genexis,pulse-ex400.dtb
 dtb-$(CONFIG_BOARD_MT7621_RFB) += mediatek,mt7621-rfb.dtb
 dtb-$(CONFIG_BOARD_MT7621_NAND_RFB) += mediatek,mt7621-nand-rfb.dtb
 dtb-$(CONFIG_BOARD_MT7628_RFB) += mediatek,mt7628-rfb.dtb
diff --git a/arch/mips/dts/genexis,pulse-ex400-common.dtsi b/arch/mips/dts/genexis,pulse-ex400-common.dtsi
new file mode 100644
index 00000000000..98d36af8cc7
--- /dev/null
+++ b/arch/mips/dts/genexis,pulse-ex400-common.dtsi
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2024 Mauri Sandberg
+ *
+ */
+
+#include "mt7621.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	aliases {
+		ethernet0 = &eth;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = &uart0;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_status_green: led-0 {
+			label = "green:status";
+			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led_status_red: led-1 {
+			label = "red:status";
+			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+	};
+
+	options {
+		u-boot {
+			activity-led = <&led_status_green>;
+			boot-led = <&led_status_red>;
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@eb00000 {
+			compatible = "ramoops";
+			reg = <0x0eb00000 0x00010000>;
+			record-size = <0x1000>;
+		};
+	};
+};
+
+&pinctrl {
+	state_default: pin_state {
+		nand {
+			groups = "spi", "sdxc";
+			function = "nand";
+		};
+
+		gpios {
+			groups = "i2c", "uart3", "pcie reset";
+			function = "gpio";
+		};
+
+		wdt {
+			groups = "wdt";
+			function = "wdt rst";
+		};
+
+		jtag {
+			groups = "jtag";
+			function = "jtag";
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&gpio {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&ssusb {
+	status = "okay";
+};
+
+&u3phy {
+	status = "okay";
+};
diff --git a/arch/mips/dts/genexis,pulse-ex400.dts b/arch/mips/dts/genexis,pulse-ex400.dts
new file mode 100644
index 00000000000..c0ea2418c8e
--- /dev/null
+++ b/arch/mips/dts/genexis,pulse-ex400.dts
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2024 Mauri Sandberg
+ *
+ */
+
+/dts-v1/;
+
+#include "genexis,pulse-ex400-common.dtsi"
+
+/ {
+	compatible = "genexis,pulse-ex400", "mediatek,mt7621-soc";
+	model = "Genexis Pulse EX400";
+};
diff --git a/arch/mips/mach-mtmips/mt7621/Kconfig b/arch/mips/mach-mtmips/mt7621/Kconfig
index 8fe6e0a2d9a..336fd8ffe70 100644
--- a/arch/mips/mach-mtmips/mt7621/Kconfig
+++ b/arch/mips/mach-mtmips/mt7621/Kconfig
@@ -79,6 +79,11 @@ config MT7621_BOOT_FROM_NAND
 choice
 	prompt "Board select"
 
+config BOARD_MT7621_GENEXIS_EX400
+	bool "Genexis Pulse EX400"
+	help
+	  Genexis Pulse EX400 board.
+
 config BOARD_MT7621_RFB
 	bool "MediaTek MT7621 RFB (SPI-NOR)"
 	help
@@ -103,6 +108,7 @@ endchoice
 
 config SYS_CONFIG_NAME
 	default "mt7621" if  BOARD_MT7621_RFB || BOARD_MT7621_NAND_RFB
+	default "mt7621" if  BOARD_MT7621_GENEXIS_EX400
 
 config SYS_BOARD
 	string "Board name"
